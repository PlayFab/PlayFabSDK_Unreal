# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
# *.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
# *.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
**/Binaries/*
**/Plugins/**/Binaries/*

# Builds
**/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
**/Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*
**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Ignore extract PlayFab.C SDK. It should be downloaded and place into this directory manually.
**/PlayFabUnrealSample/Plugins/PlayFabUnreal/External/GDK
**/PlayFabUnrealSample/Plugins/PlayFabUnreal/External/Win32

# Ignore NDA Platform Nuget packages and binaries
**/Platforms/PS4/Microsoft.PlayFab.Multiplayer.Cpp.*
**/Platforms/PS4/Microsoft.PlayFab.PlayFabParty.Cpp.*
**/Platforms/PS4/Microsoft.PlayFab.UnifiedSDK.Cpp.*

**/Platforms/PS5/Microsoft.PlayFab.Multiplayer.Cpp.*
**/Platforms/PS5/Microsoft.PlayFab.PlayFabParty.Cpp.*
**/Platforms/PS5/Microsoft.PlayFab.UnifiedSDK.Cpp.*

**/Platforms/Switch/Microsoft.PlayFab.PlayFabParty.Cpp.*
**/Platforms/Switch/Microsoft.PlayFab.Multiplayer.Cpp.*
**/Platforms/Switch/Microsoft.PlayFab.UnifiedSDK.Cpp.*
